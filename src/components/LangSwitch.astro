---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	path: string;
}

const { lang, path } = Astro.props;
---

<ul class="lang-switch mono">
	{
		(Object.keys(languages) as Lang[]).map((l) => (
			<li>
				<a
					href={getRelativeLocaleUrl(l, path)}
					hreflang={l}
					lang={l}
					aria-current={l === lang ? 'true' : undefined}
					title={languages[l]}
				>
					{l.toUpperCase()}
				</a>
			</li>
		))
	}
</ul>

<style>
	.lang-switch {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
		font-size: 0.8rem;
	}
	a {
		display: block;
		padding: 0.35rem 0.6rem;
		color: var(--muted);
		text-decoration: none;
	}
	a[aria-current] {
		background: var(--accent-soft);
		color: var(--text);
	}
</style>
