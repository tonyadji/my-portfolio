---
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<footer>
	<div class="container row">
		<span class="muted">© {new Date().getFullYear()} {profile.shortName}. {t('footer.built')}</span>
		<span class="links">
			<a href={profile.github} rel="me">GitHub</a>
			<a href={profile.linkedin} rel="me">LinkedIn</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 0;
		font-size: 0.875rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
</style>
