---
import { education, spokenLanguages } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section">
	<div class="container grid">
		<div>
			<h2 class="section-title">{t('about.title')}</h2>
			<p>{t('about.p1')}</p>
			<p>{t('about.p2')}</p>
		</div>
		<aside>
			<div class="card">
				<h3>{t('about.education')}</h3>
				<p class="strong">{education.degree[lang]}</p>
				<p class="muted small">{education.school}<br />{education.location[lang]} · {education.years}</p>
			</div>
			<div class="card">
				<h3>{t('about.languages')}</h3>
				<ul>
					{spokenLanguages.map((l) => <li><span>{l.name[lang]}</span><span class="muted">{l.level[lang]}</span></li>)}
				</ul>
			</div>
		</aside>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 2.5rem;
	}
	aside {
		display: grid;
		gap: 1rem;
		align-content: start;
	}
	h3 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0 0 0.75rem;
	}
	.card p {
		margin: 0;
	}
	.strong {
		font-weight: 600;
	}
	.small {
		font-size: 0.875rem;
		margin-top: 0.25rem !important;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.925rem;
	}
	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
