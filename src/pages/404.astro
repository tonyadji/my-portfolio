---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('en');
const tFr = useTranslations('fr');
---

<BaseLayout lang="en" title={t('404.title')}>
	<section class="container notfound">
		<p class="mono code">404</p>
		<h1>{t('404.title')}</h1>
		<p class="muted" lang="fr">{tFr('404.title')}</p>
		<div class="cta">
			<a class="btn btn-primary" href="/">{t('404.back')}</a>
			<a class="btn" href="/fr/" lang="fr">{tFr('404.back')}</a>
		</div>
	</section>
</BaseLayout>

<style>
	.notfound {
		padding: 8rem 16px;
		text-align: center;
	}
	.code {
		color: var(--accent);
		font-size: 1.5rem;
		margin: 0;
	}
	h1 {
		margin: 0.5rem 0;
	}
	.cta {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
